#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/*
 * Position des touches (ordre à respecter dans chaque couche) :
 *
 *   S1   S2   S3   S4
 *   S5   S6   S7   S8
 *   S9   S10  S11  S12
 *   S13  S14  S15  S16  S17  S18
 */

/ {
    keymap {
        compatible = "zmk,keymap";

        main_layer {
            bindings = <
                &none &none &none &none
                &none &none &none &none
                &none &none &none &none
                &none &none &none &none &none &none
            >;
        };

        numpad_layer {
            bindings = <
                &none &none &none &none
                &none &none &none &none
                &none &none &none &none
                &none &none &none &none &none &none
            >;
        };
    };
};
